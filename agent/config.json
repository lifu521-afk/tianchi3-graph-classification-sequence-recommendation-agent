{
  "budget": {
    "max_rounds": 5,
    "max_seconds_per_experiment": 1800,
    "max_total_seconds": 7200,
    "min_lift": 0.0002,
    "stop_after_no_improve": 3,
    "require_multi_split_for_promotion": false
  },
  "agent_policy": {
    "selection": "feedback_weighted_serial_ucb",
    "planner": "deterministic",
    "one_experiment_at_a_time": true,
    "local_metrics_are_not_official": true,
    "official_feedback_is_external": true
  },
  "targets": {"A1_accuracy": 0.87, "A2_ndcg_at_10": 0.512},
  "official_reference": {},
  "promotion": {
    "write_root_prediction_zip": false,
    "require_agent_stability_audit": false,
    "required_zip_members": ["A1.csv", "A2.csv"]
  },
  "experiments": [
    {
      "id": "baseline_reproducible_both_tasks",
      "task": "A1+A2",
      "kind": "submission",
      "protocol_ids": {"A1": "baseline", "A2": "baseline"},
      "script": "src/run_solution.py",
      "args": ["--output-dir", "{run_dir}"],
      "result_file": "experiment_log.json",
      "metric_paths": {"A1": "classification.selected_validation_accuracy", "A2": "recommendation.selected_validation_ndcg_at_10"},
      "max_trials": 1,
      "cost_seconds": 900,
      "hypothesis": "Reproduce the registered baseline before testing a new method.",
      "description": "Baseline experiment using the public solution runner."
    }
  ]
}
